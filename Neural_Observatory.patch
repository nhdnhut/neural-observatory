+
+class AlgorithmTests(unittest.TestCase):
+    def test_softmax_extremes(self):
+        p=softmax([10000,10001,-10000])
+        self.assertAlmostEqual(sum(p),1.0)
+        self.assertTrue(all(math.isfinite(v) for v in p))
