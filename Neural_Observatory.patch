+<nav class="tabs" aria-label="Các phần thí nghiệm">
+ <button type="button" class="tab active" data-tab="inspect" aria-selected="true">01 <span>Khám phá lớp mạng</span></button>
+ <button type="button" class="tab" data-tab="learning" aria-selected="false">02 <span>Quá trình học</span></button>
+ <button type="button" class="tab" data-tab="budget" aria-selected="false">03 <span>Ngân sách bộ nhớ</span></button>
